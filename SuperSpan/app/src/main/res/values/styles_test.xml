<?xml version="1.0" encoding="utf-8"?>

<resources>
    <!-- Tema SOLO per le Activity di test (Material3, no ActionBar) -->
    <style name="Theme.SuperSpan.NavbarDemo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/greenIcon_test</item>
        <item name="colorSecondary">@color/greenNav_test</item>
        <item name="android:navigationBarColor">@color/greenNav_test</item>
    </style>

    <!-- Arrotonda gli angoli superiori della BottomAppBar -->
    <style name="BottomBarShapeOverlayTest">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
