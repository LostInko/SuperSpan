<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CONTENUTO PAGINA (rimane fermo; l’overlay si sovrappone) -->
    <LinearLayout
        android:id="@+id/pageContent"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Titolo -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Coupon in negozio"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/greenText" />

            <!-- Bottone info -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnInfo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:srcCompat="@drawable/ic_info"
                app:tint="@color/greenIcon" />
        </LinearLayout>

        <!-- Immagini coupon -->
        <LinearLayout
            android:id="@+id/couponsContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 1 -->
            <ImageView
                android:id="@+id/imgCoupon1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp"/>

            <!-- 2 -->
            <ImageView
                android:id="@+id/imgCoupon2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp"/>

            <!-- 3 -->
            <ImageView
                android:id="@+id/imgCoupon3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="25dp">
        </LinearLayout>
    </LinearLayout>

    <!-- OVERLAY: Barra espandibile sopra la pagina -->
    <include
        layout="@layout/view_coupon_expandable_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp" />
</FrameLayout>