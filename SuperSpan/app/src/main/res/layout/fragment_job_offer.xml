        <LinearLayout
            android:id="@+id/layoutOffer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutReq">

            <TextView
                android:id="@+id/offerta"
                style="@style/textProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cosa offriamo:"
                android:textColor="@color/black"
                android:textSize="20dp" />

            <TextView
                android:id="@+id/offer_offerta"
                style="@style/descProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="approfondita descrizione dell'offerta" />

        </LinearLayout>

        <TextView
            android:id="@+id/cosaAspettiTxt"
            style="@style/descProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="Cosa aspetti?"
            android:textSize="20dp"
            android:textStyle="italic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutOffer" />


        <LinearLayout
            android:layout_width="200dp"
