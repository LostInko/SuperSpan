<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog"
    android:gravity="center">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_info"
        app:tint="@color/greenIcon"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Come usare i coupon"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/greenText"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Scegli il coupon e premi sulla card.\n2. Completa la selezione (se richiesta).\n3. Mostra il QR code in cassa per lo sconto."
        android:textSize="16sp"
        android:textColor="#444444"
        android:lineSpacingExtra="4dp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HO CAPITO"
        android:backgroundTint="@color/greenIcon"
        android:textColor="@android:color/white"
        app:cornerRadius="8dp"/>

</LinearLayout>