<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    tools:context=".ui.fragment.OrderHistoryFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TOP SINISTRA: back -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBackTop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/greenIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_button"
            android:padding="8dp" />

        <TextView
            android:id="@+id/titleAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I tuoi ordini"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/greenText"
            app:layout_constraintTop_toTopOf="@id/btnBackTop"
            app:layout_constraintBottom_toBottomOf="@id/btnBackTop"
            app:layout_constraintStart_toEndOf="@id/btnBackTop"
            android:layout_marginStart="16dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:nestedScrollingEnabled="true"
            tools:listitem="@layout/item_order"/>


    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="663dp">

        <TextView
            android:id="@+id/tvEmptyOrders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Non hai ancora effettuato ordini"
            android:visibility="gone"
            tools:layout_editor_absoluteX="106dp"
            tools:layout_editor_absoluteY="224dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>