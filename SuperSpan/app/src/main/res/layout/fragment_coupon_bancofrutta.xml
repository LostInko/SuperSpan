<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBackTop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_button"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/greenIcon" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/bancofrutta_title"            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/greenText" />

    </LinearLayout>

    <!-- Immagine coupon (anteprima) -->
    <ImageView
        android:id="@+id/imgCouponPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name" />

    <!-- Spiegazione breve -->
    <TextView
        android:id="@+id/tvExplain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="@string/bancofrutta_explain"
        android:textSize="18sp"
        android:textColor="@color/gray_600" />

    <!-- Bottoni azione -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <!-- Annulla -->
        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/cancel"
            android:textStyle="bold"
            android:textColor="@color/greenText"
            android:background="@drawable/bg_confirm_bar_disabled" />

        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <!-- Conferma -->
        <TextView
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/activate_coupon"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_confirm_bar_enabled" />
    </LinearLayout>

</LinearLayout>