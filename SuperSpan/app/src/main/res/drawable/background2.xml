<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:height="360dp">
        <shape>
            <solid android:color="#EBEBEB"/>
        </shape>
    </item>

    <item android:top="360dp">
        <shape>
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/greenet"
                android:endColor="#EBEBEB"/>
        </shape>
    </item>

    <item android:gravity="bottom" android:height="100dp">
        <shape>
            <solid android:color="@color/greenet"/> <corners
            android:topLeftRadius="16dp"
            android:topRightRadius="16dp" /> </shape>
    </item>

</layer-list>