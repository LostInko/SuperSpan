<!-- res/drawable/bg_bottom_panel.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Colore di base del pannello -->
    <solid android:color="@android:color/white" />

    <!-- Arrotondamento SOLO in alto -->
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />

    <!-- Padding interno minimo (puoi ometterlo se già gestito nel layout) -->
    <padding
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp" />
</shape>