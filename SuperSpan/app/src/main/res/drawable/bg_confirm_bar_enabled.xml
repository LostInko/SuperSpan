<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2E7D32"/> <!-- verde un po' più scuro -->
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <!-- Normal -->
    <item>
        <shape>
            <solid android:color="#4CAF50"/> <!-- verde conferma -->
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>